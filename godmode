local gs = game.GetService
local pl = gs(game, "Players")
local rs = gs(game, "RunService")
local lp = pl.LocalPlayer
local rsw = rs.RenderStepped
local wait = task.wait
local rnd = math.random
local rad = math.rad
local ang = CFrame.Angles
local v3 = Vector3.new

local function root()
    local c = lp.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

rs.Heartbeat:Connect(function()
    local hrp = root()
    if not hrp then
        return
    end

    hrp.CFrame = hrp.CFrame * ang(0, rad(0.5), 0)
    local old = hrp.Velocity
    hrp.Velocity = v3(0, -16384, 0)
    rsw:Wait()
    hrp.Velocity = old
end)

rs.Stepped:Connect(function()
    wait(0.1)

    local hrp = root()
    if not hrp then
        return
    end

    local old = hrp.AssemblyLinearVelocity
    hrp.AssemblyLinearVelocity = v3(rnd(-2000, 6000), rnd(-13000, 3000), rnd(-6000, 2000))
    rsw:Wait()
    hrp.AssemblyLinearVelocity = old
end)
